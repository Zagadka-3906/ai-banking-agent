# 复制此文件并重命名为 .env。不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
BANK_LLM_MODEL=deepseek-chat
BANK_API_BASE=http://127.0.0.1:8000/api/v1
BANK_DEMO_USER_ID=user_zhang

# Core security settings. Use a long random value outside local demos.
BANK_AUTH_SECRET=replace-with-a-random-32-byte-secret
BANK_DEMO_MODE=1
BANK_MFA_TEST_OTP=888888
BANK_REQUIRE_CLIENT_AUTH=0
# Audit administrator token with three effects: (1) /security/audit may query
# any subject, (2) /security/audit/verify requires it, (3) when set,
# /tasks/run-due requires it for a global run instead of the user-scoped path.
BANK_ADMIN_AUDIT_TOKEN=
BANK_TOKEN_TTL_SECONDS=120
BANK_MFA_TTL_SECONDS=120
BANK_CIRCUIT_FAILURE_THRESHOLD=5
BANK_CIRCUIT_WINDOW_SECONDS=300
BANK_CIRCUIT_LOCKOUT_SECONDS=300
BANK_MAX_INPUT_LENGTH=2000
BANK_MAX_TRANSFER_CENTS=100000000
# Wallet and card policy.  Per-transaction limits are NOT card policy: without
# an independent ceiling a single MFA approval could raise a card's daily limit
# to the transfer maximum (10,000 yuan) or beyond.  Cards and contacts are both
# part of the persisted ledger, whose snapshot is rewritten in full on every
# mutation, so both collections need a ceiling as well as a per-item bound.
BANK_MAX_CARDS_PER_USER=10
BANK_MAX_CARD_DAILY_LIMIT=200000
BANK_MAX_CONTACTS_PER_USER=200
# Gateway controls: per-principal request window (0 disables) and the
# session-credential switch. With BANK_REQUIRE_SESSION=1 every private Core
# /api/v1/ read or write requires X-Session-Token issued by /api/v1/auth/login.
BANK_RATE_LIMIT_PER_MINUTE=240
BANK_REQUIRE_SESSION=1
BANK_SESSION_TTL_SECONDS=900

# --- Login (P2) -----------------------------------------------------------
# The demo accounts (user_zhang / user_li / user_wife) share the password
# "Bank@2026", stored only as an argon2id digest.  Provision real credentials
# through an enrolment flow; never ship a source constant.
# Require an SMS code in addition to the password at login (0 = password only).
BANK_LOGIN_REQUIRE_OTP=0
BANK_MIN_PASSWORD_LENGTH=8
# Behaviour-combination circuit breaker: signals are weighted inside a rolling
# window and a score above the threshold opens the account lockout.  Rules
# include "report lost after a large transfer", "password change after a large
# transfer", "large transfer after a limit change", transfer/card-change bursts
# and "failures then success".
BANK_BEHAVIOR_WINDOW_SECONDS=600
BANK_BEHAVIOR_RISK_THRESHOLD=80
BANK_BEHAVIOR_LARGE_AMOUNT_CENTS=200000
BANK_HTTP_TIMEOUT_SECONDS=8
BANK_SANDBOX_TIMEOUT_SECONDS=1.5
BANK_SANDBOX_MAX_EXPRESSION=1000
BANK_SANDBOX_MAX_INPUT_BYTES=200000
BANK_SANDBOX_MAX_RESULT_BYTES=200000
# Diagnostics only: a thread cannot isolate model-generated analysis code.
# Keep disabled for demonstrations and deployments.
BANK_SANDBOX_ALLOW_THREAD_FALLBACK=0
BANK_IDEMPOTENCY_TTL_SECONDS=86400
BANK_IDEMPOTENCY_MAX_RECORDS=10000
BANK_AUDIT_MAX_EVENTS=5000
BANK_AUTH_TOKEN_MAX_RECORDS=20000
# Optional: set this only when using a real MFA provider outside demo mode.
BANK_MFA_OTP=
# Biometric factor: an enrolled Android P-256 key signs each server challenge.
BANK_FACE_CHALLENGE_TTL_SECONDS=60

# Optional append-only audit file. When set, the hash chain is replayed and
# re-verified at start-up, so verification and decision-chain traces survive a
# restart (a tampered file keeps only its verified prefix).
BANK_AUDIT_LOG_PATH=
# Optional durable device registry. Device public keys live in memory by
# default, so a restart forgets enrolled signing devices.
# Point this at a file to keep them.  The file carries an integrity digest: keyed
# (HMAC) when BANK_AUTH_SECRET is configured, otherwise a plain checksum that
# only detects corruption - /api/v1/security/health reports which one is in force
# under "devices": {"persistence": {...}}.  A file that fails its digest is
# refused *and* writes are frozen, so a later enrollment cannot overwrite it.
# Owned by the core process, which is the only component that mutates the
# registry.
BANK_DEVICE_STORE_PATH=

# --- Channel gateway (agent_api.py) ---------------------------------------
# Durable conversation checkpoints.  Set to "memory" to accept the in-process
# saver, which loses every pending approval on restart.
BANK_CONVERSATION_DB=agent_conversations.sqlite3
# Lifetime of an approval handle.  MUST stay below BANK_TOKEN_TTL_SECONDS: the
# handle points at an authorization nonce the core refuses once expired.
BANK_APPROVAL_TTL_SECONDS=110
BANK_APPROVAL_MAX_ATTEMPTS=5
# Per-principal request window for the gateway (0 disables).
BANK_AGENT_RATE_LIMIT_PER_MINUTE=60
# Optional canonical Feige relay; this is NOT the platform's webhook secret.
# A verified provider adapter must translate official events to this relay.
BANK_FEIGE_RELAY_SECRET=

# --- Durable business state -------------------------------------------------
# The core ledger (accounts, transactions, reservations, risk counters) is in
# memory by default, so a restart empties every balance back to the demo seed.
# Point BANK_LEDGER_STORE_PATH at a file - OUTSIDE this repository - and every
# committed mutation is snapshotted there atomically and replayed at start-up.
# The file carries an integrity digest keyed by BANK_AUTH_SECRET (a plain
# corruption checksum without one, reported by /api/v1/security/health under
# "ledger_persistence"); a file that fails validation is refused and writes are
# frozen rather than overwritten.  Owned by the core process only.
BANK_LEDGER_STORE_PATH=
# The gateway's pending-approval registry persists next to BANK_CONVERSATION_DB
# by default (<db>.approvals.json) so a pending approval survives a gateway
# restart.  Point this at another file to relocate it, or at "memory" to opt
# out.  Same digest/freeze rules as the ledger.
BANK_APPROVAL_STORE_PATH=
