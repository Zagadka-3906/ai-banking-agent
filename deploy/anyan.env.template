# 安言 server configuration. install.sh fills the two secrets once; the model
# keys are written by deploy.sh --copy-model-keys or by hand. Never commit this
# file once filled in.

# --- Models (empty: deterministic rules only, the demo still works) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
BANK_LLM_MODEL=deepseek-chat
BANK_MODEL_FAST_PATH=0
BANK_MODEL_TIMEOUT_SECONDS=12
BANK_MODEL_MAX_RETRIES=0
DASHSCOPE_API_KEY=
BANK_ASR_ENABLED=1

# --- Core security ---
BANK_DEMO_MODE=1
BANK_AUTH_SECRET=__AUTH_SECRET__
BANK_ADMIN_AUDIT_TOKEN=__ADMIN_TOKEN__
# Approval-bound 60-second demo codes only; no fixed code fallback.
BANK_MFA_DYNAMIC_OTP=1
BANK_REQUIRE_SESSION=1
# Core advances due reminders and birthday orders on this period (seconds; 0 disables).
# Money movement still waits for the owner's fresh approval.
BANK_TASK_SCHEDULER_SECONDS=60
BANK_REQUIRE_CLIENT_AUTH=0
BANK_LOGIN_REQUIRE_OTP=0
BANK_RATE_LIMIT_PER_MINUTE=120
BANK_AGENT_RATE_LIMIT_PER_MINUTE=30
BANK_SANDBOX_ALLOW_THREAD_FALLBACK=0

# --- Wiring and durable state (outside the code directory) ---
BANK_API_BASE=http://127.0.0.1:8000/api/v1
BANK_LEDGER_STORE_PATH=/var/lib/anyan/ledger.json
BANK_DEVICE_STORE_PATH=/var/lib/anyan/devices.json
BANK_CONVERSATION_DB=/var/lib/anyan/conversations.sqlite3
BANK_AUDIT_LOG_DIR=/var/lib/anyan/audit

# --- Optional Feishu bot (outbound long connection, no inbound port) ---
BANK_FEISHU_ENABLED=0
FEISHU_APP_ID=
FEISHU_APP_SECRET=
