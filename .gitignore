# Python 虚拟环境与字节码
venv/
.venv/
.venv-*/
env/
.runtime/
__pycache__/
*.pyc
*.pyo

# 测试与静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 敏感配置文件
.env
*.key

# 会话检查点（渠道网关）：本地运行产物，不入库
agent_conversations.sqlite3*
*.sqlite3-shm
*.sqlite3-wal
.tmp-conversations.sqlite3*

# 设备注册表落盘文件：内容是设备公钥，属敏感材料，不入库
agent_devices.json*
devices.json.tmp

# Android 客户端构建产物
android/.gradle/
android/.kotlin/
android/local.properties
android/build/
android/**/build/

# 验证/冒烟脚本的本地产物（截图、帧图、日志）
/build/
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab

# 本机凭据目录与服务账号私钥不得提交
android/app/google-services.json
*firebase-adminsdk*.json
*service-account*.json
secrets/

.tmp-screenshots/

# 实测过程的临时录屏与中间帧
test-shots/
.coverage
.coverage.*
htmlcov/
