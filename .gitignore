# Python 虚拟环境与字节码
venv/
.venv/
.venv-*/
env/
.runtime/
__pycache__/
*.pyc
*.pyo

# 测试与静态检查缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 敏感配置文件
.env
*.key

# Streamlit 缓存
.streamlit/

# 会话检查点（渠道网关）：本地运行产物，不入库
agent_conversations.sqlite3*
*.sqlite3-shm
*.sqlite3-wal
.tmp-conversations.sqlite3*

# 设备注册表落盘文件：内容是设备公钥与推送令牌，属敏感材料，不入库
agent_devices.json*
devices.json.tmp

# Android 客户端构建产物
android/.gradle/
android/.kotlin/
android/local.properties
android/build/
android/**/build/
android/.idea/
android/*.iml
android/captures/
*.apk
*.aab

# Firebase 客户端配置与推送服务账号凭据。
# google-services.json 严格来说不是密钥（其中的 API key 受包名+签名指纹限制），
# 但它绑定某一个 Firebase 项目，且 CI 在没有它时应当仍能构建（推送自动降级）。
# 本地放入 android/app/google-services.json 即自动启用推送，不要提交。
android/app/google-services.json
# 服务账号私钥：这是真正的凭据，绝不能入库。
*firebase-adminsdk*.json
*service-account*.json
# docker compose 的只读挂载源：放进去的服务账号私钥同样不入库。
secrets/

.tmp-screenshots/
